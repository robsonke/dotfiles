export TERM="xterm-256color"

# Colorize ls output (BSD ls on macOS needs this)
export CLICOLOR=1

# GKE auth settings
export USE_GKE_GCLOUD_AUTH_PLUGIN=True

# Language environment
export LANG=en_US.UTF-8

# History Configuration
export HISTSIZE=100000
export SAVEHIST=100000
export HISTFILE="$HOME/.zsh_history"
setopt EXTENDED_HISTORY

# ==========================================
# 1. INITIALIZE COMPLETIONS (CRITICAL FOR ZOXIDE)
# ==========================================
autoload -Uz compinit
if [[ -n "${ZDOTDIR:-$HOME}/.zcompdump(#qN.m+1)" ]]; then
  compinit
else
  compinit -C
fi

# ==========================================
# 2. PATHS & ENVIRONMENT ALTERATIONS
# ==========================================
export CLOUDSDK_PYTHON_SITEPACKAGES=1
export PATH="$PATH:/Users/robsonke/.local/bin"

# Auto add the latest sqlcl, needed for sqlcl mcp server
if [ -d /opt/homebrew/Caskroom/sqlcl ]; then
  export PATH="/opt/homebrew/Caskroom/sqlcl/$(ls /opt/homebrew/Caskroom/sqlcl | tail -1)/sqlcl/bin:$PATH"
fi

# ==========================================
# 3. ALIASES, FUNCTIONS & TOOLS
# ==========================================

# load my aliases and functions
for file in ~/.{aliases,functions}; do
  [ -r "$file" ] && [ -f "$file" ] && source "$file"
done
unset file

# Fixed: Avoids infinite recursion loop by using 'command git'
hash git &>/dev/null;
if [ $? -eq 0 ]; then
  function diff() {
    command git diff --no-index --color-words "$@";
  }
fi;

# Enable starship prompt
eval "$(starship init zsh)"

# zoxide: Configured AFTER compinit so completions attach perfectly
eval "$(zoxide init zsh --cmd cd --hook pwd)"

# atuin: searchable shell history (ctrl+r), synced across sessions
eval "$(atuin init zsh)"

# ==========================================
# 4. LAZY LOADING & HEAVY SCRIPTING
# ==========================================
export NVM_DIR="$HOME/.nvm"

_nvm_lazy_load() {
  unset -f nvm node npm npx corepack
  [ -s "/opt/homebrew/opt/nvm/nvm.sh" ] && \. "/opt/homebrew/opt/nvm/nvm.sh"
  [ -s "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm" ] && \. "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm"
}

for _nvm_cmd in nvm node npm npx corepack; do
  eval "${_nvm_cmd}() { _nvm_lazy_load; ${_nvm_cmd} \"\$@\"; }"
done
unset _nvm_cmd

# load all keychain passphrases
ssh-add --apple-load-keychain -q

# Machine-local secrets and overrides (Keep at bottom)
[ -f ~/.dotfiles/overrides/local.zsh ] && source ~/.dotfiles/overrides/local.zsh
